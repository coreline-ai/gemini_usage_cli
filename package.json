{
    "name": "gemini-usage-cli",
    "version": "0.1.0",
    "description": "CLI tool for tracking Gemini usage",
    "type": "module",
    "bin": {
        "gemini-usage": "./dist/index.js"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm --clean --dts",
        "dev": "tsup src/index.ts --format esm --watch --clean",
        "start": "node dist/index.js"
    },
    "keywords": [
        "gemini",
        "google",
        "ai",
        "usage",
        "cli"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "chalk": "^5.3.0",
        "commander": "^12.1.0",
        "inquirer": "^9.2.23",
        "string-width": "^7.2.0"
    },
    "devDependencies": {
        "@types/inquirer": "^9.0.7",
        "@types/node": "^22.10.2",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2"
    },
    "engines": {
        "node": ">=18"
    }
}
